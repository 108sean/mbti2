<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MBTI 아이돌 매칭</title>
  <style>
    :root {
      --pink: #FFB7C5;
      --pink-hover: #FF9EAF;
      --mint: #A8E6CF;
      --mint-hover: #8EE0C0;
      --bg-color: #FFF0F5;
      --card-bg: #FFFFFF;
      --text-color: #4A4A4A;
      --shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-color);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    .container {
      background-color: var(--card-bg);
      border-radius: 24px;
      box-shadow: var(--shadow);
      padding: 32px 24px;
      max-width: 500px;
      width: 100%;
      text-align: center;
    }

    h1 {
      font-size: 1.8rem;
      margin-bottom: 12px;
      color: #FF6B8B;
    }

    p.subtitle {
      font-size: 1.1rem;
      color: #777;
      margin-bottom: 24px;
    }

    /* MBTI 그리드 버튼 영역 */
    .mbti-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-bottom: 20px;
    }

    .mbti-btn {
      background-color: var(--pink);
      color: #FFF;
      border: none;
      border-radius: 14px;
      padding: 14px 0;
      font-size: 1.1rem;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .mbti-btn:hover {
      background-color: var(--pink-hover);
      transform: translateY(-2px);
    }

    /* 결과 카드 영역 */
    .result-card {
      display: none;
      animation: fadeIn 0.4s ease-in-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .heart-icon {
      font-size: 4rem;
      margin: 10px 0;
    }

    .idol-name {
      font-size: 2rem;
      font-weight: bold;
      color: #333;
      margin-bottom: 6px;
    }

    .mbti-tag {
      display: inline-block;
      background-color: var(--mint);
      color: #2D6A4F;
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 1rem;
      font-weight: bold;
      margin-bottom: 16px;
    }

    .reason-box {
      background-color: #FAF0F2;
      border-radius: 16px;
      padding: 18px;
      font-size: 1.1rem;
      line-height: 1.6;
      word-break: keep-all;
      margin-bottom: 20px;
      color: #555;
    }

    .chemistry-box {
      background-color: #E8F8F5;
      border-radius: 16px;
      padding: 14px;
      font-size: 1.1rem;
      color: #2A7B62;
      font-weight: bold;
      margin-bottom: 24px;
    }

    .reset-btn {
      background-color: var(--mint);
      color: #1B4D3E;
      border: none;
      border-radius: 16px;
      padding: 14px 28px;
      font-size: 1.2rem;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.2s ease;
      width: 100%;
    }

    .reset-btn:hover {
      background-color: var(--mint-hover);
      transform: translateY(-2px);
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- 메인 화면 -->
    <div id="selection-screen">
      <h1>✨ MBTI 아이돌 찾기 ✨</h1>
      <p class="subtitle">나의 MBTI를 선택해 보세요!</p>
      <div class="mbti-grid" id="mbti-grid"></div>
    </div>

    <!-- 결과 화면 -->
    <div id="result-screen" class="result-card">
      <div class="mbti-tag" id="res-mbti"></div>
      <div class="heart-icon" id="res-heart"></div>
      <div class="idol-name" id="res-name"></div>
      <div class="reason-box" id="res-reason"></div>
      <div class="chemistry-box" id="res-chem"></div>
      <button class="reset-btn" onclick="resetSelection()">다시 고르기 🔄</button>
    </div>
  </div>

  <script>
    // 16가지 MBTI 데이터
    const mbtiData = {
      "ENFP": {
        idol: "방탄소년단 뷔",
        heart: "💜",
        reason: "풍부한 상상력과 통통 튀는 기발함으로 주변을 밝게 만드는 에너지가 똑 닮았어요!\n자유롭고 창의적인 퍼포먼스가 매력적입니다.",
        chemistry: "ISTJ"
      },
      "INFJ": {
        idol: "아이유",
        heart: "💚",
        reason: "깊은 감성과 통찰력으로 사람들의 마음을 따뜻하게 다독여주는 아티스트입니다.\n섬세한 표현력이 매우 잘 어울려요.",
        chemistry: "ENFP"
      },
      "INTJ": {
        idol: "ITZY 류진",
        heart: "🤍",
        reason: "단단한 중심과 주관을 바탕으로 무대 위에서 독보적인 존재감을 발산해요.\n철저한 자기관리와 카리스마가 닮았습니다.",
        chemistry: "ENFP"
      },
      "ENTP": {
        idol: "세븐틴 승관",
        heart: "🩵",
        reason: "재치 넘치는 입담과 솔직한 매력으로 어딜 가나 분위기 메이커 역할을 완벽히 해냅니다.\n순발력과 센스가 대단해요.",
        chemistry: "INFJ"
      },
      "ESFP": {
        idol: "TWICE 지효",
        heart: "💗",
        reason: "넘치는 지치지 않는 에너지와 주위 사람들까지 기분 좋게 만드는 해피 바이러스입니다.\n무대 위의 열정이 돋보여요.",
        chemistry: "ISFJ"
      },
      "ISFP": {
        idol: "라이즈 앤톤",
        heart: "🧡",
        reason: "조용하지만 감각적인 예술성을 지니고 있어 음악과 스타일에 자신만의 색채를 차분히 담아냅니다.\n온화한 분위기가 매력적이에요.",
        chemistry: "ESFJ"
      },
      "ESTP": {
        idol: "전소미",
        heart: "❤️",
        reason: "거침없는 자신감과 자유로운 에너지가 보는 이의 스트레스를 날려줍니다.\n어떤 상황에서도 당당하고 멋진 모습을 보여줘요.",
        chemistry: "ISFJ"
      },
      "ISTP": {
        idol: "투모로우바이투게더 범규",
        heart: "💙",
        reason: "쿨하고 무심한 듯 보여도 깊은 센스와 요령으로 일을 척척 해내는 츤데레 매력이 있습니다.\n무대 위 갭모에가 인상적이에요.",
        chemistry: "ESFJ"
      },
      "ENFJ": {
        idol: "엑소 찬열",
        heart: "🖤",
        reason: "타인을 진심으로 배려하며 팀을 부드럽게 이끄는 리더십과 따뜻한 마음씨를 지녔습니다.\n사랑스러운 매력이 가득해요.",
        chemistry: "INFP"
      },
      "INFP": {
        idol: "샤이니 태민",
        heart: "💚",
        reason: "남다른 감수성과 내면의 강인함으로 무대 위에서 시적인 아우라를 그려냅니다.\n꿈꾸는 듯한 몽환적인 분위기가 찰떡입니다.",
        chemistry: "ENFJ"
      },
      "ENTJ": {
        idol: "동방신기 유노윤호",
        heart: "💛",
        reason: "지치지 않는 열정과 명확한 비전으로 목표를 향해 끝없이 도전하는 베테랑 아이돌입니다.\n리더십의 정석을 보여줍니다.",
        chemistry: "INTP"
      },
      "INTP": {
        idol: "방탄소년단 슈가",
        heart: "🩶",
        reason: "깊은 프로듀싱 능력과 논리적이고 깊은 통찰력으로 본인만의 음악 세계를 완성해 나갑니다.\n차분한 전문가의 아우라가 느껴져요.",
        chemistry: "ENTJ"
      },
      "ESFJ": {
        idol: "세븐틴 도겸",
        heart: "🩵",
        reason: "주변 사람들을 꼼꼼하게 챙기며 다정한 온기를 건네는 밝고 솔직한 사람입니다.\n친근하고 정이 넘쳐요.",
        chemistry: "ISFP"
      },
      "ISFJ": {
        idol: "NCT 제노",
        heart: "💖",
        reason: "묵묵하고 성실하게 자신의 위치를 지키며 팀원들을 이끌어주는 든든한 수호자 타입입니다.\n선하고 따뜻한 에너지를 줍니다.",
        chemistry: "ESFP"
      },
      "ESTJ": {
        idol: "BLACKPINK 제니",
        heart: "🩷",
        reason: "확실한 취향과 프로페셔널한 애티튜드로 트렌드를 선도해 나가는 당찬 매력의 소유자입니다.\n야무진 카리스마가 돋보여요.",
        chemistry: "INTP"
      },
      "ISTJ": {
        idol: "아이브 가을",
        heart: "🤎",
        reason: "차분하고 안정감 있는 모습으로 언제나 기복 없는 완벽한 퍼포먼스를 보여줍니다.\n신뢰감을 주는 은은한 매력이 있어요.",
        chemistry: "ENFP"
      }
    };

    const mbtiList = Object.keys(mbtiData);
    const gridContainer = document.getElementById('mbti-grid');

    // MBTI 버튼 생성
    mbtiList.forEach(mbti => {
      const btn = document.createElement('button');
      btn.className = 'mbti-btn';
      btn.textContent = mbti;
      btn.onclick = () => selectMBTI(mbti);
      gridContainer.appendChild(btn);
    });

    // 선택 처리
    function selectMBTI(mbti) {
      const data = mbtiData[mbti];
      
      document.getElementById('res-mbti').textContent = mbti;
      document.getElementById('res-heart').textContent = data.heart;
      document.getElementById('res-name').textContent = data.idol;
      document.getElementById('res-reason').innerText = data.reason;
      document.getElementById('res-chem').textContent = `💞 잘 맞는 궁합: ${data.chemistry}`;

      document.getElementById('selection-screen').style.display = 'none';
      document.getElementById('result-screen').style.display = 'block';
    }

    // 다시 고르기
    function resetSelection() {
      document.getElementById('selection-screen').style.display = 'block';
      document.getElementById('result-screen').style.display = 'none';
    }
  </script>
</body>
</html>
